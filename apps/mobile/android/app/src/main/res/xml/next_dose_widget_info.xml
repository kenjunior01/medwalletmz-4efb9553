<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Próxima Toma" — metadados do AppWidget.
     updatePeriodMillis = 30 min (mínimo permitido): re-render se o
     sistema matar o processo; a app também refresca em tempo real
     através do MethodChannel sempre que o plano muda. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="56dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/next_dose_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/wdg_desc" />
