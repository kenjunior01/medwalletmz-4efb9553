        <intent
            android:action="mz.medwallet.SHORTCUT"
            android:targetPackage="mz.medwallet"
            android:targetClass="mz.medwallet.MainActivity">
            <extra android:name="route" android:value="/sos" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_meddy"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_meddy_label"
        android:shortcutLongLabel="@string/shortcut_meddy_long">
        <intent
            android:action="mz.medwallet.SHORTCUT"
            android:targetPackage="mz.medwallet"
            android:targetClass="mz.medwallet.MainActivity">
            <extra android:name="route" android:value="/meddy" />
        </intent>
    </shortcut>
</shortcuts>
