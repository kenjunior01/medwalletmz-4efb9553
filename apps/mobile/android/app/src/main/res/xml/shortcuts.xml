<?xml version="1.0" encoding="utf-8"?>
<!-- App Shortcuts — long-press no ícone da app (Android 7.1+).
     Cada atalho lança a MainActivity com extra "route"; o Dart
     (NativeBridge) navega com GoRouter para o ecrã destino. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_scan"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_scan_label"
        android:shortcutLongLabel="@string/shortcut_scan_long">
        <intent
            android:action="mz.medwallet.SHORTCUT"
            android:targetPackage="mz.medwallet"
            android:targetClass="mz.medwallet.MainActivity">
            <extra android:name="route" android:value="/scan-qr" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_meds"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_meds_label"
        android:shortcutLongLabel="@string/shortcut_meds_long">
