            android:action="mz.medwallet.SHORTCUT"
            android:targetPackage="mz.medwallet"
            android:targetClass="mz.medwallet.MainActivity">
            <extra android:name="route" android:value="/meds" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_sos"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_sos_label"
