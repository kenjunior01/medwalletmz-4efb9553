<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Próxima Toma" — cartão escuro com a marca, nome do
     medicamento e hora da próxima toma. Toque abre a app na Medicação. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wdg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/wdg_bg"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Ícone/badge da marca -->
    <LinearLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/wdg_badge">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wdg_brand"
            android:textColor="#FFFFFF"
            android:textSize="7sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />
        <TextView
            android:id="@+id/wdg_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="••:••"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <!-- Estado vazio -->
        <LinearLayout
            android:id="@+id/wdg_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wdg_empty_title"
                android:textColor="#F2F7FB"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wdg_empty_sub"
                android:textColor="#9FB3C8"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Estado com toma agendada -->
        <LinearLayout
            android:id="@+id/wdg_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wdg_header"
                android:textColor="#9FB3C8"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:maxLines="1" />
            <TextView
                android:id="@+id/wdg_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F2F7FB"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/wdg_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#14B8A6"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
