# =============================================================================
# MedWallet MZ — Environment Variables
# =============================================================================
# COPY THIS FILE TO .env.local AND FILL IN YOUR VALUES
# NEVER commit .env or .env.local to the repository
# =============================================================================

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Google Maps Platform
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
VITE_GOOGLE_MAPS_CHANNEL=your-tracking-id

# Mapbox (optional, fallback for maps)
VITE_MAPBOX_TOKEN=your-mapbox-token

# Shopify Storefront API (Loja Global — dropshipping EUA/Canadá)
# Token PÚBLICO da Storefront (só leitura de produtos + carrinhos).
VITE_SHOPIFY_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token
# VITE_SHOPIFY_API_VERSION=2025-01

# -----------------------------------------------------------------------------
# NVIDIA AI (NIM API — Edge Function «ai-assistant»)
# -----------------------------------------------------------------------------
# A chave NUNCA vive no frontend (Vite não a usa — não criar VITE_NVIDIA_*).
# Define-a como SECRET do Supabase (lida pela Edge Function via Deno.env):
#
#   supabase secrets set NVIDIA_API_KEY=nvapi-xxxxxxxx
#
# Obtém/roda a chave em: https://build.nvidia.com (grátis durante o build).
# Modelos usados (fixados no código, sem env necessária):
#   Chat:    nvidia/nemotron-3-ultra-550b-a55b
#   Embed:   nvidia/nemotron-3.5-embed-8b (4096 dims)
#   Vision:  nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# Enquanto o secret não existir, a Edge Function usa a FALLBACK_NVIDIA_KEY
# em supabase/functions/ai-assistant/index.ts — APAGAR essa linha depois de
# definir o secret e rodar a chave (ver docs/ASSISTENTE_IA_README.md).
