# =============================================================================
# MedWallet MZ — Environment Variables
# =============================================================================
# COPY THIS FILE TO .env.local AND FILL IN YOUR VALUES
# NEVER commit .env or .env.local to the repository
# =============================================================================

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Google Maps Platform
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
VITE_GOOGLE_MAPS_CHANNEL=your-tracking-id

# Mapbox (optional, fallback for maps)
VITE_MAPBOX_TOKEN=your-mapbox-token

# Shopify Storefront API (Loja Global — dropshipping EUA/Canadá)
# Token PÚBLICO da Storefront (só leitura de produtos + carrinhos).
VITE_SHOPIFY_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token
# VITE_SHOPIFY_API_VERSION=2025-01
